# Copy to .env (scripts/generate-secrets.sh does this for you) and edit.
# Passwords and keys do NOT live here -- they are files under ./secrets,
# mounted into the containers as Docker secrets.

########################################
# Core
########################################
SITE_NAME=PowerDNS Admin
# Published port of the admin panel.
WEBUI_PORT=9191
# Address the DNS service binds to on the host. Use 127.0.0.1 to keep it local.
DNS_BIND_ADDRESS=0.0.0.0
# Host port for DNS. Change this if something already listens on 53 --
# systemd-resolved does on most Ubuntu and Fedora systems. The container always
# serves on 53 internally; this only affects the host side.
DNS_PORT=53
LOG_LEVEL=INFO

# Public URL of the panel, without a trailing slash. Required for OAuth and
# SAML, which have to hand the identity provider an absolute redirect URL.
# BASE_URL=https://dns.example.com

# Set to true when the panel is served over HTTPS. Leave false for plain HTTP,
# otherwise the session cookie is never sent back and login silently fails.
SESSION_COOKIE_SECURE=false
# Number of reverse proxies in front of the panel. Leave 0 unless you run one;
# trusting X-Forwarded-For blindly lets clients spoof their address.
TRUSTED_PROXY_COUNT=0
SESSION_LIFETIME_MINUTES=480

########################################
# Database
########################################
DB_NAME=pdns
PDNS_DB_USER=pdns
WEBUI_DB_USER=pdnsadmin
WEBUI_DB_SCHEMA=pdnsadmin

########################################
# PowerDNS
########################################
# SOA record used for new zones that do not override it.
PDNS_DEFAULT_SOA_CONTENT=ns1.example.com hostmaster.example.com 0 10800 3600 604800 3600
# Reported in CHAOS TXT version.bind. "anonymous" hides the exact version.
PDNS_VERSION_STRING=anonymous
PDNS_LOGLEVEL=4
# Pre-filled on the "new zone" form, comma separated.
DEFAULT_NAMESERVERS=ns1.example.com,ns2.example.com

########################################
# First-run administrator
########################################
# Only used while the user table is empty. The password is in
# secrets/webui_admin_password. Change it after the first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=

########################################
# Authentication -- local accounts
########################################
# Turn this off once an external provider works, to force SSO.
LOCAL_AUTH_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=300

########################################
# Authentication -- LDAP / Active Directory
########################################
LDAP_ENABLED=false
# LDAP_URI=ldaps://dc1.example.com:636
# LDAP_START_TLS=false
# LDAP_TLS_VERIFY=true
# LDAP_CA_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# Service account used to look the user up before binding as them.
# LDAP_BIND_DN=CN=svc-dns,OU=Service Accounts,DC=example,DC=com
# LDAP_BIND_PASSWORD=
# LDAP_BASE_DN=DC=example,DC=com
# Active Directory: sAMAccountName. OpenLDAP: uid.
# LDAP_USERNAME_ATTRIBUTE=sAMAccountName
# LDAP_EMAIL_ATTRIBUTE=mail
# LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
# LDAP_GROUP_ATTRIBUTE=memberOf
# {username} and {username_attribute} are substituted before the search.
# LDAP_USER_FILTER=(&(objectClass=person)({username_attribute}={username}))
# Group -> role mapping. Accepts a bare group name or a full DN, comma separated.
# LDAP_ADMIN_GROUP=DNS-Admins
# LDAP_OPERATOR_GROUP=DNS-Operators
# LDAP_USER_GROUP=DNS-Users
# Role for users matching no group. Set to "none" to refuse them entirely.
# LDAP_DEFAULT_ROLE=none

########################################
# Authentication -- OAuth 2.0 / OpenID Connect
########################################
# Comma-separated list of provider names. Each NAME below is that name
# upper-cased, so "keycloak" reads OAUTH_KEYCLOAK_*.
# Redirect URI to register with the provider:
#   ${BASE_URL}/auth/oauth/<name>/callback
# OAUTH_PROVIDERS=keycloak,github

# --- OpenID Connect provider (Keycloak, Authentik, Entra ID, Google, Okta) ---
# OAUTH_KEYCLOAK_DISPLAY_NAME=Company SSO
# OAUTH_KEYCLOAK_CLIENT_ID=powerdns-admin
# OAUTH_KEYCLOAK_CLIENT_SECRET=
# OAUTH_KEYCLOAK_DISCOVERY_URL=https://sso.example.com/realms/main/.well-known/openid-configuration
# OAUTH_KEYCLOAK_SCOPES=openid email profile
# OAUTH_KEYCLOAK_USERNAME_CLAIM=preferred_username
# OAUTH_KEYCLOAK_GROUPS_CLAIM=groups
# OAUTH_KEYCLOAK_ADMIN_GROUP=dns-admins
# OAUTH_KEYCLOAK_DEFAULT_ROLE=none

# --- Plain OAuth 2.0 provider (GitHub has no OIDC discovery document) ---
# OAUTH_GITHUB_DISPLAY_NAME=GitHub
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# OAUTH_GITHUB_USERINFO_URL=https://api.github.com/user
# OAUTH_GITHUB_SCOPES=read:user user:email
# OAUTH_GITHUB_USERNAME_CLAIM=login
# OAUTH_GITHUB_ICON=ti-brand-github

########################################
# Authentication -- SAML 2.0
########################################
SAML_ENABLED=false
# Service provider metadata is served at ${BASE_URL}/auth/saml/metadata
# and the assertion consumer URL is ${BASE_URL}/auth/saml/acs
# Either point at the IdP's metadata document...
# SAML_IDP_METADATA_URL=https://sso.example.com/realms/main/protocol/saml/descriptor
# ...or configure the IdP by hand:
# SAML_IDP_ENTITY_ID=https://sso.example.com/realms/main
# SAML_IDP_SSO_URL=https://sso.example.com/realms/main/protocol/saml
# SAML_IDP_SLO_URL=
# SAML_IDP_X509_CERT=
# Attribute names carrying the user's identity in the assertion.
# SAML_ATTR_USERNAME=username
# SAML_ATTR_EMAIL=email
# SAML_ATTR_NAME=displayName
# SAML_ATTR_GROUPS=groups
# SAML_ADMIN_GROUP=dns-admins
# SAML_DEFAULT_ROLE=none
# Optional SP signing keypair, needed only if the IdP requires signed requests.
# SAML_SP_X509_CERT=
# SAML_SP_PRIVATE_KEY=
