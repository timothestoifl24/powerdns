# Generated by /entrypoint.sh on container start -- edits here are lost on
# restart. To change a setting, set the matching RECURSOR_* environment
# variable (see README) or put YAML in RECURSOR_EXTRA_YAML.
#
# YAML rather than the classic key=value syntax: Recursor 5.2 stopped reading
# old-style settings unless --enable-old-settings is passed, and that option is
# documented as going away in a future release.

incoming:
  listen: __LISTEN__
  port: __LOCAL_PORT__
  # Who may ask this resolver to recurse. The default is private networks
  # only. A recursor reachable from the internet is an open resolver: it will
  # be used to amplify denial-of-service traffic against someone else. Widen
  # this only for networks you control.
  allow_from: __ALLOW_FROM__

dnssec:
  # process (validate when asked), validate (always), log-fail, off.
  validation: __DNSSEC__

webservice:
  # The admin panel manages forward zones exclusively through this API. Keep
  # the port unpublished on the host unless you deliberately want external
  # access.
  webserver: true
  api_key: __API_KEY__
  address: __WEBSERVER_ADDRESS__
  port: __WEBSERVER_PORT__
  allow_from: __WEBSERVER_ALLOW_FROM__
  # Zones created through the API are written here as an "apizones" YAML file
  # and read back at start, which is what makes a forward zone survive a
  # restart. It must differ from recursor.include_dir below: under YAML
  # settings the recursor refuses to have them point at the same place.
  api_dir: __API_DIR__

recursor:
  daemon: false
  write_pid: false
  threads: __THREADS__
  setuid: pdns
  setgid: pdns
  socket_dir: /var/run/pdns-recursor
  version_string: __VERSION_STRING__
  # Read after this file, so anything here overrides the settings above.
  include_dir: __INCLUDE_DIR__
  # Deliberately empty. The API refuses to manage zones unless the forwarding
  # settings are present in a configuration file; the zones themselves live in
  # the apizones file under api_dir above.
  forward_zones: []
  forward_zones_recurse: []

logging:
  disable_syslog: true
  timestamp: false
  loglevel: __LOGLEVEL__
  quiet: __QUIET__
