# Generated by /entrypoint.sh on container start -- edits here are lost on
# restart. To change a setting, set the matching PDNS_* environment variable
# (see README) or drop a .conf file into /etc/powerdns/pdns.d.

#################################
# Backend: PostgreSQL (gpgsql)
#################################
launch=gpgsql
gpgsql-host=__PGSQL_HOST__
gpgsql-port=__PGSQL_PORT__
gpgsql-user=__PGSQL_USER__
gpgsql-password=__PGSQL_PASSWORD__
gpgsql-dbname=__PGSQL_DBNAME__
gpgsql-dnssec=__PGSQL_DNSSEC__

#################################
# Built-in HTTP API + webserver
#################################
# The admin panel drives PowerDNS exclusively through this API. Keep the port
# unpublished on the host unless you deliberately want external API access.
api=yes
api-key=__API_KEY__
webserver=yes
webserver-address=__WEBSERVER_ADDRESS__
webserver-port=__WEBSERVER_PORT__
webserver-allow-from=__WEBSERVER_ALLOW_FROM__

#################################
# DNS service
#################################
local-address=__LOCAL_ADDRESS__
local-port=__LOCAL_PORT__
default-soa-content=__DEFAULT_SOA_CONTENT__
default-ttl=__DEFAULT_TTL__
version-string=__VERSION_STRING__

#################################
# Container-friendly runtime
#################################
daemon=no
guardian=no
disable-syslog=yes
log-timestamp=no
loglevel=__LOGLEVEL__
write-pid=no
setuid=pdns
setgid=pdns

# Read last, so anything here overrides the settings above.
include-dir=/etc/powerdns/pdns.d
