# Generated by /entrypoint.sh on container start -- edits here are lost on
# restart. To change a setting, set the matching RECURSOR_* environment
# variable (see README) or drop a .conf file into the api-config-dir below.

#################################
# DNS service
#################################
local-address=__LOCAL_ADDRESS__
local-port=__LOCAL_PORT__

# Who may ask this resolver to recurse. The default is private networks only.
# A recursor reachable from the internet is an open resolver: it will be used
# to amplify denial-of-service traffic against someone else. Widen this only
# for networks you control.
allow-from=__ALLOW_FROM__

# DNSSEC validation: process (validate when asked), validate (always), off.
dnssec=__DNSSEC__

#################################
# Built-in HTTP API + webserver
#################################
# The admin panel manages forward zones exclusively through this API. Keep the
# port unpublished on the host unless you deliberately want external access.
webserver=yes
api-key=__API_KEY__
webserver-address=__WEBSERVER_ADDRESS__
webserver-port=__WEBSERVER_PORT__
webserver-allow-from=__WEBSERVER_ALLOW_FROM__

# Zones created through the API are written here as .conf fragments and read
# back through include-dir, which is why the two must be the same directory:
# that is what makes a forward zone survive a restart. Both settings must also
# appear in a configuration file rather than on the command line, or the
# generated fragments are ignored.
api-config-dir=__API_CONFIG_DIR__
include-dir=__API_CONFIG_DIR__

# Deliberately empty. The API refuses to manage zones unless these are set in a
# configuration file, and the fragments in api-config-dir append to them.
forward-zones=
forward-zones-recurse=

#################################
# Container-friendly runtime
#################################
daemon=no
write-pid=no
disable-syslog=yes
log-timestamp=no
loglevel=__LOGLEVEL__
quiet=__QUIET__
threads=__THREADS__
socket-dir=/var/run/pdns-recursor
version-string=__VERSION_STRING__
setuid=pdns
setgid=pdns
